# ── Groq (LLM) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
# Recommended models (free tier, fast):
#   llama-3.3-70b-versatile   — best quality
#   llama-3.1-8b-instant      — fastest
#   mixtral-8x7b-32768        — good balance
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (Embeddings) ───────────────────────────────────────────────────────
# Run: ollama pull nomic-embed-text
#      ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Server config ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
# Explicit origins only: auth uses cookies, and browsers reject "*" with credentials.
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
LOG_LEVEL=INFO                    # DEBUG shows pipeline sizes and counts

# ── PostgreSQL (needs the pgvector extension: CREATE EXTENSION vector;) ────────
DATABASE_URL=postgresql+asyncpg://spl3_user:your-db-password@localhost:5432/spl3

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false               # true when served over HTTPS

# Google OAuth2 (authorization-code flow). Leave empty to hide "Continue with Google".
# Google Cloud Console → Credentials → OAuth client ID (Web application):
#   Authorized redirect URI:  http://localhost:4200/auth/google/callback
#   Also enable the "People API" (used to read the account's email).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Per-case index cache ──────────────────────────────────────────────────────
INDEX_CACHE_MAX_CASES=4           # how many cases' indexes stay in RAM
