# ── LLM provider ─────────────────────────────────────────────────────────────
# Choose: gemini | groq
LLM_PROVIDER=gemini

# ── Embedding provider ────────────────────────────────────────────────────────
# Choose: gemini | ollama
# Note: Groq does not provide an embedding API.
#       When LLM_PROVIDER=groq, set EMBED_PROVIDER=ollama (run: ollama pull nomic-embed-text)
EMBED_PROVIDER=gemini

# ── Gemini (LLM_PROVIDER=gemini  or  EMBED_PROVIDER=gemini) ──────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# ── Groq (LLM_PROVIDER=groq) ─────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
# Recommended models (free tier, fast):
#   llama-3.3-70b-versatile   — best quality
#   llama-3.1-8b-instant      — fastest
#   mixtral-8x7b-32768        — good balance
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (EMBED_PROVIDER=ollama) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Run:  ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Server config ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
