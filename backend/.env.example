# ═════════════════════════════════════════════════════════════════════════════
# GraphRAG Investigations — environment settings
# Copy to backend/.env and fill in the values marked REQUIRED. Never commit .env.
# Keep comments on their own lines (not after a value).
# ═════════════════════════════════════════════════════════════════════════════

# ── LLM: OpenRouter (any OpenAI-compatible API works) ────────────────────────
# REQUIRED. Create a key at https://openrouter.ai/settings/keys (needs credits).
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
# openai/gpt-oss-20b: cheap and fast. Change the model here without touching code.
LLM_MODEL=openai/gpt-oss-20b
# How many LLM requests run at once while indexing.
LLM_MAX_CONCURRENCY=16
# OpenRouter host choice: throughput (fastest, recommended) | price (cheapest, very slow) | latency
LLM_PROVIDER_SORT=throughput

# ── Embeddings: Ollama (local) ───────────────────────────────────────────────
# Run once: ollama pull nomic-embed-text   — then keep `ollama serve` running.
# Use 127.0.0.1, not localhost: on Windows localhost adds ~2 s to every request.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Database: PostgreSQL 18 + pgvector ───────────────────────────────────────
# REQUIRED. Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (e.g. @ → %40, # → %23).
# The database needs pgvector, once, as postgres:  CREATE EXTENSION vector;
DATABASE_URL=postgresql+asyncpg://spl3_user:your-db-password@localhost:5432/spl3

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED (the server refuses to start without it). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# true only when the site is served over HTTPS.
COOKIE_SECURE=false

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Leave both empty to hide "Continue with Google".
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application):
#   Authorized redirect URI:  http://localhost:4200/auth/google/callback
# Also enable the "People API" (used to read the account's email).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Where the Angular app runs. Google redirects back to FRONTEND_URL/auth/google/callback.
FRONTEND_URL=http://localhost:4200
# Comma-separated, explicit origins only: auth uses cookies, and browsers reject "*".
CORS_ORIGINS=http://localhost:4200

# ── Uploads ──────────────────────────────────────────────────────────────────
# Relative upload paths are resolved from the project root, even when launched from backend/.
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# ── Performance / logging ────────────────────────────────────────────────────
# How many cases' indexes stay in RAM (the dev machine has ~8 GB).
INDEX_CACHE_MAX_CASES=4
# DEBUG | INFO | WARNING | ERROR. DEBUG shows pipeline sizes and counts.
LOG_LEVEL=INFO
